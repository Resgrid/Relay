<Project>
  <!--
    Product metadata for every assembly. The release workflow overrides Version (and with it AssemblyVersion,
    FileVersion and InformationalVersion) with -p:Version=<major>.<minor>.<run>; local builds report 2.1.0.
  -->
  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">2.1.0</Version>
    <Company>Resgrid, LLC</Company>
    <Product>Resgrid Relay</Product>
    <Copyright>Copyright © Resgrid, LLC</Copyright>
    <Authors>Resgrid, LLC</Authors>
  </PropertyGroup>

  <!--
    Shared properties for every project. The NET10_0_WINDOWS compile symbol is defined in
    Directory.Build.targets, not here: this file is imported before a project's own
    <TargetFramework> is set, so a condition on $(TargetFramework) here only works for
    multi-targeted inner builds and silently missed single-target Windows projects (the
    desktop app compiled its Windows-only tune meter out).
  -->
</Project>
